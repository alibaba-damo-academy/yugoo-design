    <bpmn:sequenceFlow id="SequenceFlow_P-002_8" name="重试" sourceRef="ExclusiveGateway_P-002_2" targetRef="SendTask_P-002_1" />
    <bpmn:sequenceFlow id="SequenceFlow_P-002_9" name="保留失败并稍后跟进" sourceRef="ExclusiveGateway_P-002_2" targetRef="EndEvent_P-002_1" />
