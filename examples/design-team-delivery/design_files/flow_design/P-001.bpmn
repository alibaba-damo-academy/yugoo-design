  <bpmn:process id="Process_P-001" name="客户修改请求与安排确认" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P-001">
      <bpmn:lane id="Lane_P-001_1" name="客户">
        <bpmn:flowNodeRef>StartEvent_P-001_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_P-001_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_P-001_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-001_2" name="设计师">
        <bpmn:flowNodeRef>UserTask_P-001_2</bpmn:flowNodeRef>
