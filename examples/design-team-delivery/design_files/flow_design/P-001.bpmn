        <bpmn:flowNodeRef>ExclusiveGateway_P-001_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_P-001_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_P-001_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-001_3" name="项目负责人">
        <bpmn:flowNodeRef>UserTask_P-001_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_P-001_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P-001_4" name="系统">
        <bpmn:flowNodeRef>ServiceTask_P-001_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_P-001_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_P-001_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_P-001_1" name="提交修改意见" />
    <bpmn:userTask id="UserTask_P-001_1" name="提出修改意见" />
    <bpmn:serviceTask id="ServiceTask_P-001_1" name="保存反馈并关联交付内容" />
    <bpmn:userTask id="UserTask_P-001_2" name="对照原范围判断影响" />
