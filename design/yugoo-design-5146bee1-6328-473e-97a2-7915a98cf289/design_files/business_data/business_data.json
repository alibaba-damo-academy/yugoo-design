      "id": "BO-001",
      "name": "设计项目",
      "description": "一个产品设计的长期资料单位，有稳定身份、自己的定义与版本历史；不是某一Host会话。",
      "fields": {
        "identity": {
          "id": "identity",
          "name": "项目身份",
          "meaning": "区分同名或改名后的同一项目；实际由项目管理产生，不要求用户重填。",
          "value_type": "text",
          "requirement": "always",
          "required_when": "",
          "example": "",
          "options": []
        },
        "name": {
          "id": "name",
          "name": "项目名称",
          "meaning": "用户辨认设计对象的名称。",
