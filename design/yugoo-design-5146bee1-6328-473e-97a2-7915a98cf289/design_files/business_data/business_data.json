    "BO-006": {
      "id": "BO-006",
      "name": "设计建议",
      "description": "独立审阅对具体设计证据提出的待处理建议；它本身不是已确认需求。",
      "fields": {
        "finding": {
          "id": "finding",
          "name": "问题与依据",
          "meaning": "指出具体不一致、可能遗漏或意图偏移，并保留来源范围。",
          "value_type": "long_text",
          "requirement": "always",
          "required_when": "",
          "example": "",
          "options": []
        },
        "proposal": {
          "id": "proposal",
          "name": "建议处理",
          "meaning": "可供用户判断的修订方向，不代表已执行。",
          "value_type": "long_text",
          "requirement": "optional",
          "required_when": "",
          "example": "",
          "options": []
        }
      },
      "field_order": [
        "finding",
        "proposal"
      ],
      "states": {
        "pending": {
          "id": "pending",
          "name": "待处理",
          "meaning": "尚未得到用户处理决定。"
        },
        "deferred": {
          "id": "deferred",
          "name": "已延后",
          "meaning": "用户选择暂不处理，理由和上下文仍有用。"
        },
        "accepted": {
          "id": "accepted",
          "name": "已接受",
          "meaning": "用户决定接受建议；不等同目标设计已经修订。"
        },
        "rejected": {
          "id": "rejected",
          "name": "已拒绝",
          "meaning": "用户决定不采用，保留实际处理记录。"
        }
      },
      "state_order": [
        "pending",
        "deferred",
        "accepted",
        "rejected"
      ]
    },
    "BO-007": {
      "id": "BO-007",
      "name": "建议处理决定",
