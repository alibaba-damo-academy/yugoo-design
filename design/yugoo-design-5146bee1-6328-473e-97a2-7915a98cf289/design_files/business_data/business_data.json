        "notes": {
          "id": "notes",
          "name": "备注",
          "meaning": "补充依据、理由、未决点和必要限制；不是新增的通用疑问集合。",
          "value_type": "long_text",
          "requirement": "optional",
          "required_when": "",
          "example": "",
