    "BO-009": {
      "id": "BO-009",
      "name": "设计知识关系",
      "description": "项目知识归档中保留的来源关联、提议和已记录决定；与原生事实及派生视图区分。 中立归档archive必须随项目携带，包含人的关系、提议和决定；Ladybug数据库与向量缓存可重建。结构恢复依赖DesignFiles加archive，单靠原生文件不能还原全部人的处置；语义重建依赖实际模型能力。",
      "fields": {
        "meaning": {
          "id": "meaning",
          "name": "关系含义",
          "meaning": "具体连接了什么、依据是什么，不能只留一条无含义的线。",
          "value_type": "long_text",
          "requirement": "always",
          "required_when": "",
          "example": "",
          "options": []
        },
        "basis": {
          "id": "basis",
          "name": "来源与适用范围",
          "meaning": "关系可以回查的原生来源及证据限制。",
          "value_type": "long_text",
          "requirement": "always",
          "required_when": "",
          "example": "",
          "options": []
        },
        "decision": {
          "id": "decision",
          "name": "提议与决定说明",
          "meaning": "区分观察、提议和人的决定；状态不能由相似度或图形位置推定。",
          "value_type": "long_text",
          "requirement": "optional",
          "required_when": "",
          "example": "",
          "options": []
        }
      },
      "field_order": [
        "meaning",
        "basis",
        "decision"
      ],
