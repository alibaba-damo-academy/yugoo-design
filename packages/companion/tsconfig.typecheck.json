{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node", "react", "react-dom"],
    "typeRoots": ["../core/node_modules/@types", "../panel/node_modules/@types"],
    "paths": {
      "react": ["../panel/node_modules/@types/react/index.d.ts"],
      "react/*": ["../panel/node_modules/@types/react/*.d.ts"],
      "react-dom/*": ["../panel/node_modules/@types/react-dom/*.d.ts"],
      "@deepseek-ai/cordis": ["../panel/node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"],
      "dsh-design-panel/client-api": ["../panel/src/client-api.ts"],
      "dsh-design-panel/sample-preview": ["../panel/src/sample-preview.tsx"]
    }
  },
  "include": ["src/client.tsx", "src/component-skill-resource.d.ts", "../panel/src/client/css.d.ts", "../panel/src/client/graph-layout-worker-source.d.ts", "../provider-web-app/src/client/bpmn-js.d.ts"]
}
