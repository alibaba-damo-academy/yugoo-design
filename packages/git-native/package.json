{
  "name": "yugoo-design-git-native",
  "version": "0.1.0-beta.2",
  "description": "Node-only local Git binding for Yugoo Design, with bounded object-header access.",
  "license": "MIT",
  "main": "index.cjs",
  "types": "index.d.ts",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "native/*.node",
    "LICENSE",
