    "native-source/**",
    "third-party/**",
    "scripts/*.cjs"
  ],
  "scripts": {
    "test": "node --test test/header.test.mjs",
    "prepack": "node scripts/check-artifacts.cjs",
    "build:native": "node scripts/build.cjs"
  }
}
