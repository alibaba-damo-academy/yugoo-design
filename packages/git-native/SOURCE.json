  "version": "0.1.0-beta.2",
  "upstream": {
    "name": "@napi-rs/simple-git",
    "version": "1.2.0",
    "repository": "https://github.com/Brooooooklyn/simple-git",
    "gitHead": "0cdb713269151a7af05718c745a718f0f2bd37f9",
    "license": "MIT"
  },
  "modifications": [
    "Independent package identity and local artifact loader; never override the upstream npm version.",
    "Repository.readObjectHeader returns ODB type/size or null on NotFound; other failures throw.",
    "Remove implicit global Git configuration creation.",
    "Lock Cargo dependencies, enable runtime Node-API dynamic symbols, and build local Git without unused SSH/HTTPS/OpenSSL transports.",
    "Platform prebuilds are produced by the maintainer, never compiled on user installation.",
    "Add source-built macOS arm64 support with a relocatable Mach-O install name; retain Linux/Windows pins and no Git CLI fallback."
  ],
  "capabilities": {
    "gitScope": "local immutable objects, refs, trees, status and index operations",
    "networkTransports": false,
    "fallbackToGitExecutable": false,
    "platforms": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin"
    ]
  },
